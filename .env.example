# alert-bot-demo — copy to `.env` and fill in. One file serves both processes (API and MCP).

# ---------------------------------------------------------------------------
# Admin API (what cadmin talks to)
# ---------------------------------------------------------------------------
# Brands this instance serves. Comma-separated or a JSON list. Each gets its own `alert_bot_<brand>`
# database; the checker rows of every brand share `alert_bot_system.checkers_configs`.
BRANDS=DEMO,ACME
# The Bearer token cadmin sends on every admin call — paste the same value into the cadmin service's
# "secret key". Empty = every admin call is refused with 403.
ADMIN_API_SECRET_KEY=change-me
MONGO_URI=mongodb://localhost:27017
# Seed demo rows (checker configs, settings, segments, a small alert journal) for a brand that has
# none yet. Idempotent: a brand that already holds rows is left alone.
SEED_ON_STARTUP=true
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MCP server (src/mcp_server) — reads the same MONGO_URI
# ---------------------------------------------------------------------------
# `http` serves a team through cadmin OAuth; `stdio` runs one process for one person with their own
# cadmin token in ALERTS_MCP_CADMIN_TOKEN.
ALERTS_MCP_TRANSPORT=http
ALERTS_MCP_HOST=0.0.0.0
ALERTS_MCP_PORT=8811
# Path of the MCP endpoint. `/mcp` is what `claude mcp add --transport http ... http://host:8811/mcp` expects.
ALERTS_MCP_PATH=/mcp
# This server's externally reachable URL — the OAuth `resource` a client binds its token to.
ALERTS_MCP_PUBLIC_URL=http://localhost:8811
# cadmin decides who may read which brand. BASE_URL is where /auth/me and /services are called (WITH
# the /api/v1 prefix); ISSUER is what clients authorize against (WITHOUT the prefix) and must equal
# cadmin's own OAuth issuer (its backend's OAUTH_ISSUER) exactly.
ALERTS_MCP_CADMIN_BASE_URL=https://cadmin.test/api/v1
ALERTS_MCP_CADMIN_ISSUER=https://cadmin.test
#ALERTS_MCP_CADMIN_TOKEN=
# Where cadmin's review screen lives — the host `propose_alert_changes` links point at.
ALERTS_MCP_CADMIN_REVIEW_BASE=https://cadmin.test
#ALERTS_MCP_PRINCIPAL_TTL_SECONDS=60
#ALERTS_MCP_DISCOVERY_TIMEOUT_SECONDS=5
